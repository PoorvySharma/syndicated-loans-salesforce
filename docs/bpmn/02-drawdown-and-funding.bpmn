<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_drawdown_and_funding" targetNamespace="https://example.org/syndicated-loans">
  <bpmn:collaboration id="Collab_drawdown_and_funding"><bpmn:participant id="Pool_drawdown_and_funding" name="Drawdown and funding" processRef="Process_drawdown_and_funding" /></bpmn:collaboration>
  <bpmn:process id="Process_drawdown_and_funding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Borrower">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Agent">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Lender">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Salesforce">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Funding need">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Submit drawdown request">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Validate request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t3" name="Reject with reason">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Request rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t4" name="Split pro-rata and notify lenders">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t5" name="Transfer funds to Agent">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Confirm funding and disburse">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t7" name="Update lender holds and facility drawn">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Borrower funded">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="No" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t7" targetRef="e2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_drawdown_and_funding">
      <bpmndi:BPMNShape id="Pool_drawdown_and_funding_di" bpmnElement="Pool_drawdown_and_funding" isHorizontal="true"><dc:Bounds x="60" y="20" width="1730" height="680" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="90" y="20" width="1700" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="90" y="190" width="1700" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="90" y="360" width="1700" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="90" y="530" width="1700" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="212" y="87" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="350" y="73" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="530" y="583" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="745" y="590" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="890" y="544" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1112" y="597" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="890" y="622" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1070" y="413" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1250" y="243" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1430" y="583" width="120" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1652" y="87" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="248" y="105" />
        <di:waypoint x="350" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="470" y="105" />
