<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_origination_and_allocation" targetNamespace="https://example.org/syndicated-loans">
  <bpmn:collaboration id="Collab_origination_and_allocation"><bpmn:participant id="Pool_origination_and_allocation" name="Origination, bookbuilding and allocation" processRef="Process_origination_and_allocation" /></bpmn:collaboration>
  <bpmn:process id="Process_origination_and_allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Borrower">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Arranger">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Lender">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Agent">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Salesforce">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Mandate signed">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Create deal and facilities">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Invite lenders">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Submit soft commitment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t4" name="Screen KYC and sanctions">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Allocate with pro-rata cut-back">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Fully allocated?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Widen syndicate or adjust amounts">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t7" name="Negotiate documents and satisfy CPs">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t8" name="Confirm CPs satisfied">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t9" name="Close facility">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Facility active">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t5" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_7" name="re-run" sourceRef="t6" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_8" name="Yes" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t9" targetRef="e" />
  </bpmn:process>
