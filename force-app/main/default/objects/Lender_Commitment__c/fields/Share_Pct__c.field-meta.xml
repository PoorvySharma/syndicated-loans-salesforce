<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Share_Pct__c</fullName>
    <label>Share of Facility (%)</label>
    <precision>18</precision>
    <scale>4</scale>
    <formula>IF(Facility__r.Commitment_Amount__c = 0, 0, Allocated_Amount__c / Facility__r.Commitment_Amount__c * 100)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Number</type>
</CustomField>
