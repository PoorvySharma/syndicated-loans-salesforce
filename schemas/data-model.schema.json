{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/syndicated-loans/schemas/data-model.schema.json",
  "title": "Structure of data-model.json",
  "type": "object",
  "required": ["apiVersion", "objects"],
  "properties": {
    "apiVersion": { "type": "string", "pattern": "^\\d+\\.0$" },
    "objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["api", "label", "desc", "fields"],
        "properties": {
          "api": { "type": "string", "pattern": "^([A-Z][A-Za-z0-9]*|[A-Z][A-Za-z0-9_]*__[ce])$" },
          "standard": { "type": "boolean" }, "event": { "type": "boolean" }, "history": { "type": "boolean" },
          "sharing": { "enum": ["ReadWrite", "ControlledByParent", "Read", "Private"] },
          "name": { "type": "object", "required": ["label", "type"], "properties": { "type": { "enum": ["Text", "AutoNumber"] }, "format": { "type": "string" } } },
          "fields": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["api", "label", "type"],
              "properties": {
                "api": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*__c$" },
                "type": { "enum": ["Text", "LongText", "Number", "Currency", "Percent", "Date", "Checkbox", "Picklist", "MultiPicklist", "Lookup", "MasterDetail", "Formula", "Rollup"] }
              },
              "allOf": [
                { "if": { "properties": { "type": { "enum": ["Lookup", "MasterDetail"] } } }, "then": { "required": ["ref", "rel", "relLabel"] } },
                { "if": { "properties": { "type": { "enum": ["Picklist", "MultiPicklist"] } } }, "then": { "required": ["values"] } },
                { "if": { "properties": { "type": { "const": "Formula" } } }, "then": { "required": ["returns", "formula"] } },
                { "if": { "properties": { "type": { "const": "Rollup" } } }, "then": { "required": ["field", "fk", "op"] } },
                { "if": { "properties": { "type": { "enum": ["Text", "LongText"] } } }, "then": { "required": ["length"] } }
              ]
            }
          }
        }
      }
    }
  }
}
